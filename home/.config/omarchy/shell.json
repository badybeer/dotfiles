{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "emby-tsukimi",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/emby-tsukimi-status",
          "onClick": "~/.local/bin/tsukimi-open",
          "interval": 3600,
          "tooltip": "Emby - Tsukimi"
        },
        {
          "id": "emby-dl",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/emby-dl-status",
          "onClick": "~/.local/bin/emby-dl-window",
          "interval": 3600,
          "tooltip": "Emby - stiahnut film"
        },
        {
          "id": "remote-desktop",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/remote-status",
          "onClick": "~/.local/bin/remote-window",
          "interval": 10,
          "tooltip": "Vzdialená plocha"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "wireguard",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/wireguard-status",
          "onClick": "~/.config/omarchy/bar/scripts/wireguard-toggle",
          "interval": 3,
          "tooltip": "WireGuard VPN"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [],
  "version": 1
}
